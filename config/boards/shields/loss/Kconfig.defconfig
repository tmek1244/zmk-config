if SHIELD_LOSS_RIGHT || SHIELD_LOSS_DONGLE

config ZMK_KEYBOARD_NAME
    default "IsThisLoss"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_LOSS_RIGHT || SHIELD_LOSS_LEFT || SHIELD_LOSS_DONGLE

config ZMK_SPLIT
    default y

endif

if SHIELD_LOSS_DONGLE

# Both halves connect to the dongle as peripherals.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# Two peripherals + the default five BT profiles.
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
