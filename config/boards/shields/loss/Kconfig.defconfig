if SHIELD_LOSS_RIGHT || SHIELD_LOSS_DONGLE

config ZMK_KEYBOARD_NAME
    default "IsThisLoss"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_LOSS_RIGHT || SHIELD_LOSS_LEFT || SHIELD_LOSS_DONGLE

config ZMK_SPLIT
    default y

endif

# The halves run on batteries; the dongle doesn't (its reading would be junk).
if SHIELD_LOSS_RIGHT || SHIELD_LOSS_LEFT

config LOSS_BATTERY_LED
    default y

# Power off after a while without typing (not while on USB power). The
# timeout is set in config/loss_left.conf and config/loss_right.conf, because
# ZMK's own default would win over one set here.
# The first key press after sleeping only wakes the half, it isn't typed.
config ZMK_SLEEP
    default y

endif

if SHIELD_LOSS_DONGLE

# Both halves connect to the dongle as peripherals.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# Two peripherals + the default five BT profiles.
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
